import sqlite3
import tkinter as tk
from tkinter import messagebox, ttk


# ==========================================
# FUNCTIONS FOR DATABASE DATABASE
# ==========================================
def conectar_banco():
    """Conecta ao banco de dados SQLite e cria a tabela se não existir."""
    conexao = sqlite3.connect("cadastro_clientes.db")
    cursor = conexao.cursor()
    cursor.execute(
        """
        CREATE TABLE IF NOT EXISTS clientes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            email TEXT NOT NULL,
            telefone TEXT NOT NULL
        )
    """
    )
    conexao.commit()
    conexao.close()


def salvar_cliente():
    """Salva os dados do formulário no banco de dados."""
    nome = entry_nome.get().strip()
    email = entry_email.get().strip()
    telefone = entry_telefone.get().strip()

    if not nome or not email or not telefone:
        messagebox.showwarning("Aviso", "Todos os campos devem ser preenchidos!")
        return

    conexao = sqlite3.connect("cadastro_clientes.db")
    cursor = conexao.cursor()
    cursor.execute(
        "INSERT INTO clientes (nome, email, telefone) VALUES (?, ?, ?)",
        (nome, email, telefone),
    )
    conexao.commit()
    conexao.close()

    messagebox.showinfo("Sucesso", "Cliente cadastrado com sucesso!")

    # Limpa os campos após salvar
    entry_nome.delete(0, tk.END)
    entry_email.delete(0, tk.END)
    entry_telefone.delete(0, tk.END)


# ==========================================
# NEW FEATURE: VIEW CUSTOMERS
# ==========================================
def visualizar_clientes():
    """Abre uma nova janela e exibe os dados dos clientes em uma tabela."""
    # Janela secundária
    janela_visualizacao = tk.Toplevel(janela_principal)
    janela_visualizacao.title("Clientes Cadastrados")
    janela_visualizacao.geometry("600x400")

    # Título da nova janela
    label_titulo = tk.Label(
        janela_visualizacao, text="Lista de Clientes", font=("Arial", 14, "bold")
    )
    label_titulo.pack(pady=10)

    # Criação da Tabela (Treeview)
    colunas = ("ID", "Nome", "E-mail", "Telefone")
    tabela = ttk.Treeview(janela_visualizacao, columns=colunas, show="headings")

    # Configuração das colunas/cabeçalhos
    tabela.heading("ID", text="ID")
    tabela.heading("Nome", text="Nome")
    tabela.heading("E-mail", text="E-mail")
    tabela.heading("Telefone", text="Telefone")

    tabela.column("ID", width=50, anchor="center")
    tabela.column("Nome", width=180, anchor="w")
    tabela.column("E-mail", width=200, anchor="w")
    tabela.column("Telefone", width=120, anchor="center")

    tabela.pack(fill="both", expand=True, padx=10, pady=10)

    # Busca os dados no banco e insere na tabela
    conexao = sqlite3.connect("cadastro_clientes.db")
    cursor = conexao.cursor()
    cursor.execute("SELECT id, nome, email, telefone FROM clientes")
    linhas = cursor.fetchall()

    for linha in linhas:
        tabela.insert("", tk.END, values=linha)

    conexao.close()


# ==========================================
# MAIN INTERFACE WINDOW (TKINTER)
# ==========================================
# Inicializa o banco de dados
conectar_banco()

# Configuração da janela principal
janela_principal = tk.Tk()
janela_principal.title("Formulário de Cadastro de Clientes")
janela_principal.geometry("400x350")

# Elementos visuais (Labels e Entries)
label_instrucao = tk.Label(
    janela_principal, text="Insira os dados do cliente:", font=("Arial", 12, "bold")
)
label_instrucao.pack(pady=15)

label_nome = tk.Label(janela_principal, text="Nome:")
label_nome.pack()
entry_nome = tk.Entry(janela_principal, width=40)
entry_nome.pack(pady=5)

label_email = tk.Label(janela_principal, text="E-mail:")
label_email.pack()
entry_email = tk.Entry(janela_principal, width=40)
entry_email.pack(pady=5)

label_telefone = tk.Label(janela_principal, text="Telefone:")
label_telefone.pack()
entry_telefone = tk.Entry(janela_principal, width=40)
entry_telefone.pack(pady=5)

# Botão para Cadastrar / Salvar
btn_salvar = tk.Button(
    janela_principal,
    text="Cadastrar Cliente",
    command=salvar_cliente,
    bg="#4CAF50",
    fg="white",
    font=("Arial", 10, "bold"),
)
btn_salvar.pack(pady=15)

# NOVO: Botão para Visualizar os Clientes
btn_visualizar = tk.Button(
    janela_principal,
    text="Visualizar Clientes",
    command=visualizar_clientes,
    bg="#2196F3",
    fg="white",
    font=("Arial", 10, "bold"),
)
btn_visualizar.pack(pady=5)

# Executa o aplicativo
janela_principal.mainloop()
